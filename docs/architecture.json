  "cards": [
    {
      "dot": "cyan",
      "title": "Context mode",
      "items": [
        "Readable on Drive: CLAUDE.md, manifest.json, sessions-index.json",
        "encrypted/<project>--claude-backup-<ts>.tar.gz.age holds sessions and memory",
        "Secret-looking files are never listed"
      ]
    },
    {
      "dot": "violet",
      "title": "Full mode",
      "items": [
        "files/objects/<sha>.age: one encrypted object per unique content",
        "files/snapshots/<ts>.json.age: encrypted index, one per change",
        "Names and contents are unreadable on Drive"
      ]
    },
    {
      "dot": "amber",
      "title": "Keys and recovery",
      "items": [
        "The machine only holds the public recipient, so it can write but not read",
        "Restore needs the private key, kept offline",
        "Optional: git push to your own private repo"
      ]
    }
  ]
